<component type="desktop-application">
  <id>io.github.frostlinuxdev.Nadare</id>
  <name>Nadare</name>
  <summary>Open-source Linux launcher for anime gacha games</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Nadare installs, updates and launches anime gacha games on Linux:
    Arknights, Stella Sora, Chaos Zero Nightmare and Fate/Grand Order (via Lepton),
    with official news and art from each publisher.</p>
    <p>Beta: expect bugs.</p>
  </description>
