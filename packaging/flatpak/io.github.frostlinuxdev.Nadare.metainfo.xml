<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.frostlinuxdev.Nadare</id>
  <name>Nadare</name>
  <summary>Open-source Linux launcher for anime gacha games</summary>
  <developer id="io.github.frostlinuxdev">
    <name>Nadare contributors</name>
  </developer>
  <url type="homepage">https://github.com/frostlinuxdev/nadare</url>
  <url type="bugtracker">https://github.com/frostlinuxdev/nadare/issues</url>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Nadare installs and runs anime games on Linux. Open the Store, pick a game,
    press Install, then press Play. Nadare downloads the game from its publisher,
    sets up Wine/Proton for you and keeps the game updated.</p>
    <p>Games include Chaos Zero Nightmare, Arknights, Arknights: Endfield, Stella Sora,
    Punishing: Gray Raven, Wuthering Waves, Genshin Impact, Honkai: Star Rail,
    Zenless Zone Zero, Honkai Impact 3rd, Brown Dust 2, Aether Gazer, Girls' Frontline 2,
    Neverness to Everness, Mongil: Star Dive, NIKKE and more.</p>
    <p>Beta: expect bugs.</p>
  </description>
