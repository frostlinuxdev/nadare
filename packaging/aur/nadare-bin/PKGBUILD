# Repackages the upstream AppImage: it is unpacked into /opt/nadare (no FUSE or
# noexec-/tmp dependency at run time) and /usr/bin/nadare points at it.
# pacman owns updates for this package; the wrapper tells Nadare not to offer a
# manual release download.
pkgname=nadare-bin
_pkgname=nadare
pkgver=0.1.0b5
pkgrel=1
pkgdesc='Open-source Linux launcher for anime gacha games (prebuilt AppImage)'
arch=('x86_64')
url='https://github.com/frostlinuxdev/nadare'
license=('GPL-3.0-only')
depends=('glibc')
optdepends=(
  'umu-launcher: preferred Proton runner for Windows games'
  'wine: Windows games and the generic Wine backend'
  'mingw-w64-gcc: rebuild the Chaos Zero Nightmare PCSDK stub from source'
  'podman: Fate/Grand Order (experimental, lepton-fgo)'
  'gnome-keyring: Secret Service keyring for account tokens'
  'kwallet: Secret Service keyring for account tokens'
)
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}" "${_pkgname}-git")
options=('!strip' '!debug')
_asset="Nadare-${pkgver}-${CARCH}.AppImage"
source=("${_asset}::${url}/releases/download/v${pkgver}/${_asset}")
noextract=("${_asset}")
sha256sums=('6f2971d6f7b53a3337f59de1d660efd9854607806bf36fa21194bcfcf31e024a')

prepare() {
  chmod +x "${_asset}"
  # --appimage-extract needs no FUSE.
  ./"${_asset}" --appimage-extract >/dev/null
}

package() {
  cd squashfs-root

  install -dm755 "${pkgdir}/opt/${_pkgname}"
  cp -a --no-preserve=ownership usr AppRun "${pkgdir}/opt/${_pkgname}/"

  install -dm755 "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/nadare" <<'EOF'
#!/bin/sh
export NADARE_MANAGED_UPDATES=1
exec /opt/nadare/usr/bin/nadare "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/nadare"

  install -Dm644 usr/share/applications/nadare.desktop \
    "${pkgdir}/usr/share/applications/nadare.desktop"
  install -Dm644 nadare.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/nadare.svg"
  install -Dm644 usr/share/licenses/nadare/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
